{
  "name": "wikipedia-game-api",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless Serverless API and Pool Pipeline for wikipedia-game",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "node --import tsx src/node.ts",
    "dev:cf": "wrangler dev src/index.ts",
    "deploy:cf": "wrangler deploy",
    "build:pool": "tsx scripts/build-pool.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "wrangler": "^3.109.2"
  }
}
